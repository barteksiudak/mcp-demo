
# --- GitHub API ---
# Personal Access Token (fine-grained lub classic) z uprawnieniem "Contents: Read-only"
# do repozytorium barteksiudak/mcp-demo.
# Wygeneruj na: https://github.com/settings/tokens

GITHUB_PERSONAL_ACCESS_TOKEN=
# Alternatywna nazwa zmiennej (wspierana jako fallback)

GITHUB_TOKEN=

# Repozytorium źródłowe danych mocków (domyślnie: barteksiudak/mcp-demo)

GITHUB_OWNER=barteksiudak

GITHUB_REPO=mcp-demo
# --- Google Drive API ---
# Opcja A: Service Account (zalecane do automatyzacji/demo)
# 1. Utwórz projekt w Google Cloud Console -> włącz "Google Drive API"
# 2. Utwórz Service Account -> wygeneruj klucz JSON
# 3. Udostępnij folder Google Drive dla adresu e-mail service accounta (co najmniej "Viewer")
# 4. Wskaż poniżej ścieżkę do pobranego pliku JSON

GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./credentials/service-account.json

# Opcja B: Prosty klucz API (tylko do publicznie udostępnionych plików, ograniczone możliwości)

GOOGLE_API_KEY=

# ID folderu "mcp demo" na Google Drive zawierającego dokumenty QA/known-issues/deployment

GOOGLE_DRIVE_FOLDER_ID=1UBCiPncfqYR904WbmayX1jzR3T_czoVK

# --- Output ---
# Katalog docelowy dla wygenerowanego raportu statusu wydania

OUTPUT_DIR=./output
